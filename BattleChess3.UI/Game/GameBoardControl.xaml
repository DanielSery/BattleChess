<UserControl x:Class="BattleChess3.UI.Game.GameBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             xmlns:game="clr-namespace:BattleChess3.UI.Game"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance game:BoardViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border BorderBrush="Black" BorderThickness="0 0 4 0"
            SnapsToDevicePixels="True"
            x:Name="ThisGameBoardControl"
            Width="{Binding ActualHeight, ElementName=ThisGameBoardControl}">
        <ItemsControl HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding BoardWidth}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <game:BoardTileControl 
                        MouseEnter="Button_MouseEnter"
                        MouseLeave="Button_MouseLeave"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>