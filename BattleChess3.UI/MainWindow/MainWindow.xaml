<Window x:Class="BattleChess3.UI.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:BattleChess3.UI.Localization"
        xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
        xmlns:menu="clr-namespace:BattleChess3.UI.Menu"
        xmlns:game="clr-namespace:BattleChess3.UI.Game"
        xmlns:editor="clr-namespace:BattleChess3.UI.Editor"
        xmlns:mainWindow="clr-namespace:BattleChess3.UI.MainWindow"
        xmlns:shared="clr-namespace:BattleChess3.UI.Shared"
        mc:Ignorable="d"
        Title="{localization:Loc MainWindow_Title}" Height="800" Width="1035" MinHeight="600" MinWidth="1035"
        d:DataContext="{d:DesignInstance mainWindow:MainWindowViewModel}"
        DataContext="{Binding Source={x:Static shared:ViewModelLocator.MainWindowViewModel}}"
        Style="{StaticResource MainWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top"
              Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    PreviewMouseDown="DragButton_MouseDown"
                    BorderThickness="4 4 2 4"
                    Background="Transparent"
                    MouseDoubleClick="Control_OnMouseDoubleClick">
                <Button.Style>
                    <Style BasedOn="{StaticResource ScalingButtonStyle}" TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1"
                    Click="MinimizeButton_Click"
                    BorderThickness="2 4 2 4"
                    Background="#40000000"
                    Style="{StaticResource ScalingButtonStyle}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="65" MinHeight="40">
                    <TextBlock Text="―"
                               FontFamily="Segoe UI"
                               FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="35" />
                </Border>
            </Button>

            <Button Grid.Column="2"
                    Click="MaximizeButton_Click"
                    BorderThickness="2 4 2 4"
                    Background="Transparent"
                    Style="{StaticResource ScalingButtonStyle}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="65" MinHeight="40">
                    <TextBlock x:Name="MaximizeButtonTextBlock"
                               Text="🗖"
                               FontFamily="Segoe UI"
                               FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="35" />
                </Border>
            </Button>

            <Button Grid.Column="3"
                    Click="CloseButton_Click"
                    BorderThickness="2 4 4 4"
                    Background="#40000000"
                    Style="{StaticResource ScalingButtonStyle}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="65" MinHeight="40">
                    <TextBlock Text="✕"
                               FontFamily="Segoe UI"
                               FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="35" />
                </Border>
            </Button>
        </Grid>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0"
                    SnapsToDevicePixels="True"
                    x:Name="ThisBorderControl"
                    Width="{Binding ActualHeight, ElementName=ThisBorderControl}"
                    Loaded="GameBoard_OnLoaded"
                    DataContextChanged="GameBoard_OnDataContextChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border x:Name="MenuBorder" Grid.Row="0" SnapsToDevicePixels="True"
                            BorderBrush="Black" BorderThickness="0 0 4 0"
                            ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="MenuTransform"/>
                        </Border.RenderTransform>
                        <menu:MenuControl DataContext="{Binding MenuViewModel}"/>
                    </Border>
                    
                    <Border Grid.Row="1" SnapsToDevicePixels="True"
                            BorderBrush="Black" BorderThickness="0 0 4 0"
                            Visibility="{Binding MenuTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <editor:TeamBoardControl DataContext="{Binding  MenuViewModel.TeamBoardViewModel}"
                                                 Opacity="0.85" IsEnabled="False"/>
                    </Border>
                    
                    <Border Grid.Row="0" Grid.RowSpan="2" x:Name="ParentGameBoardBorder"
                            BorderBrush="Black" BorderThickness="0 0 4 0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="OffsetBorder" Grid.Row="0" Height="577.5"/>
                            <Border x:Name="GameBoardBorder" Grid.Row="1" Visibility="Hidden">
                                <Border Height="{Binding ActualHeight, ElementName=ThisBorderControl}">
                                    <Border x:Name="TranslatedBorder">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="GameBoardTransform"/>
                                        </Border.RenderTransform>
                                        <game:GameBoardControl DataContext="{Binding BoardViewModel}" />
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <Border Grid.Row="0" SnapsToDevicePixels="True"
                            BorderBrush="Black" BorderThickness="0 0 0 6"
                            Visibility="{Binding EditorTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <editor:EditorUnitsControl DataContext="{Binding EditorViewModel.EditorUnits}"
                                                   Opacity="0.85" />
                    </Border>
                    <Border Grid.Row="1" SnapsToDevicePixels="True"
                            BorderBrush="Black" BorderThickness="0 0 4 0"
                            Visibility="{Binding EditorTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <editor:TeamBoardControl DataContext="{Binding EditorViewModel.TeamBoard}" />
                    </Border>
                </Grid>
            </Border>
            
            <Border Grid.Column="1" 
                    Visibility="{Binding MenuTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                    BorderBrush="Black" BorderThickness="2 0 4 0"
                    SnapsToDevicePixels="True">
                <Grid DataContext="{Binding MenuViewModel}">
                    <Border
                        Visibility="{Binding LoginShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <menu:LoginControl DataContext="{Binding LoginViewModel}" />
                    </Border>
                    <Border
                        Visibility="{Binding SignUpShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <menu:SignUpControl DataContext="{Binding SignUpViewModel}" />
                    </Border>
                    <Border
                        Visibility="{Binding LobbyShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <menu:MultiplayerLobbyControl DataContext="{Binding MultiplayerViewModel}" />
                    </Border>
                    <Border
                        Visibility="{Binding LeaderboardShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                        <menu:LeaderboardControl DataContext="{Binding LeaderboardViewModel}" />
                    </Border>
                </Grid>
            </Border>
            
            <Border x:Name="GameSideControlParent"
                    Grid.Column="1" 
                    Visibility="{Binding GameTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                    BorderBrush="Black" BorderThickness="2 0 4 0"
                    SnapsToDevicePixels="True">
                <Border x:Name="GameSideControl">
                    <game:GameSideControl />
                </Border>
            </Border>
            
            <Border x:Name="EditorSideControlParent"
                    Grid.Column="1" 
                    Visibility="{Binding EditorTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                    BorderBrush="Black" BorderThickness="0 0 4 0"
                    SnapsToDevicePixels="True">
                <Border x:Name="EditorSideControl">
                    <editor:EditorRightControl DataContext="{Binding EditorViewModel}" />
                </Border>
            </Border>

            <mainWindow:LoadingControl 
                Grid.Column="0" Grid.ColumnSpan="2"
                DataContext="{Binding LoadingService}" />

            <mainWindow:NotificationControl 
                Grid.Column="0" Grid.ColumnSpan="2"
                DataContext="{Binding NotificationService}" />
        </Grid>
    </DockPanel>
</Window>