<Window x:Class="BattleChess3.UI.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:BattleChess3.UI.Localization"
        xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
        xmlns:menu="clr-namespace:BattleChess3.UI.Menu"
        xmlns:game="clr-namespace:BattleChess3.UI.Game"
        xmlns:editor="clr-namespace:BattleChess3.UI.Editor"
        xmlns:mainWindow="clr-namespace:BattleChess3.UI.MainWindow"
        mc:Ignorable="d"
        Title="{localization:Loc MainWindow_Title}" Height="800" Width="1035" MinHeight="600" MinWidth="1035"
        d:DataContext="{d:DesignInstance mainWindow:MainWindowViewModel}"
        DataContext="{Binding Source={x:Static mainWindow:ViewModelLocator.MainWindowViewModel}}"
        Style="{StaticResource MainWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top"
              Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0"
                    PreviewMouseDown="DragButton_MouseDown"
                    BorderThickness="4 4 2 4"
                    Background="Transparent"
                    MouseDoubleClick="Control_OnMouseDoubleClick">
                <Button.Style>
                    <Style BasedOn="{StaticResource ScalingButtonStyle}" TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
                
                <Button Grid.Column="1"
                        Click="MinimizeButton_Click"
                        BorderThickness="2 4 2 4"
                        Background="#40000000"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="65" MinHeight="40">
                        <TextBlock Text="―"
                                   FontFamily="Segoe UI"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                
                <Button Grid.Column="2"
                        Click="MaximizeButton_Click"
                        BorderThickness="2 4 2 4"
                        Background="Transparent"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="65" MinHeight="40">
                        <TextBlock x:Name="MaximizeButtonTextBlock"
                                   Text="🗖"
                                   FontFamily="Segoe UI"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                
                <Button Grid.Column="3"
                        Click="CloseButton_Click"
                        BorderThickness="2 4 4 4"
                        Background="#40000000"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="65" MinHeight="40">
                        <TextBlock Text="✕"
                                   FontFamily="Segoe UI"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
        </Grid>
        
        <Grid>
            <Border Visibility="{Binding MenuTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                <menu:MenuControl DataContext="{Binding MenuViewModel}"/>
            </Border>
        
            <DockPanel LastChildFill="True"
                       Visibility="{Binding GameTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                <Border DockPanel.Dock="Left">
                    <game:GameBoardControl DataContext="{Binding BoardViewModel}" />
                </Border>
                <Border BorderBrush="Black" BorderThickness="2,0,0,0">
                    <game:GameSideControl/>
                </Border>
            </DockPanel>
        
            <Border Visibility="{Binding EditorTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                <editor:EditorControl DataContext="{Binding EditorViewModel}"/>
            </Border>
        
            <mainWindow:LoadingControl DataContext="{Binding LoadingService}"/>
        
            <mainWindow:NotificationControl DataContext="{Binding NotificationService}"/>
        </Grid>
    </DockPanel>
</Window>