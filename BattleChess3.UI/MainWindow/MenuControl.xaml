<UserControl x:Class="BattleChess3.UI.MainWindow.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             xmlns:mainWindow="clr-namespace:BattleChess3.UI.MainWindow"
             d:DataContext="{d:DesignInstance mainWindow:MenuViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="350">
    <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="1" Background="#33000000" />
                <Border Grid.Row="0" Grid.Column="3" Background="#33000000" />
                <Border Grid.Row="0" Grid.Column="5" Background="#33000000" />
                <Border Grid.Row="0" Grid.Column="7" Background="#33000000" />

                <Border Grid.Row="1" Grid.Column="0" Background="#33000000" />
                <Border Grid.Row="1" Grid.Column="2" Background="#33000000" />
                <Border Grid.Row="1" Grid.Column="4" Background="#33000000" />
                <Border Grid.Row="1" Grid.Column="6" Background="#33000000" />
                
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                        Margin="5"
                        FontSize="35"
                        Command="{Binding LocalGameCommand}"
                        BorderThickness="6"
                        Background="{StaticResource ButtonYellowBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Local game"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                
                <Border Grid.Row="2" Grid.Column="1" Background="#33000000" />
                <Border Grid.Row="2" Grid.Column="3" Background="#33000000" />
                <Border Grid.Row="2" Grid.Column="5" Background="#33000000" />
                <Border Grid.Row="2" Grid.Column="7" Background="#33000000" />

                <Button Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2"
                        FontSize="35"
                        BorderThickness="6"
                        Margin="5"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                        Command="{Binding MultiplayerViewModel.RankedGameCommand}"
                        Background="{StaticResource ButtonGreen2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Ranked game"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Button Grid.Row="2" Grid.Column="5"
                        FontSize="35"
                        Margin="5 5 0 5"
                        BorderThickness="6, 6, 3, 6"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                        Command="{Binding ShowLoginCommand}"
                        Background="{StaticResource ButtonGreenBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="112" MinHeight="40">
                        <TextBlock Text="Log in"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Button Grid.Row="2" Grid.Column="6"
                        FontSize="35"
                        Margin="0 5 5 5"
                        BorderThickness="3, 6, 6, 6"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                        Command="{Binding ShowSignUpCommand}"
                        Background="{StaticResource ButtonGreen2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="112" MinHeight="40">
                        <TextBlock Text="Sign up"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        FontSize="35"
                        Margin="5"
                        BorderThickness="6, 6, 6, 6"
                        Command="{Binding ShowLobbiesCommand}"
                        Background="{StaticResource ButtonOrange2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Lobby"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Border Grid.Row="3" Grid.Column="0" Background="#33000000" />
                <Border Grid.Row="3" Grid.Column="2" Background="#33000000" />
                <Border Grid.Row="3" Grid.Column="4" Background="#33000000" />
                <Border Grid.Row="3" Grid.Column="6" Background="#33000000" />
                
                <Button Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        Margin="5"
                        Command="{Binding SelectEditorCommand}"
                        BorderThickness="6, 6, 6, 6"
                        Background="{StaticResource ButtonGreen3Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Edit setup"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                
                <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 6, 6"
                        Margin="5"
                        Command="{Binding ShowSettingsCommand}"
                        Background="{StaticResource ButtonOrangeBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Settings"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Border Grid.Row="4" Grid.Column="1" Background="#33000000" />
                <Border Grid.Row="4" Grid.Column="3" Background="#33000000" />
                <Border Grid.Row="4" Grid.Column="5" Background="#33000000" />
                <Border Grid.Row="4" Grid.Column="7" Background="#33000000" />
                
                <Button Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 6, 6"
                        Margin="5"
                        Command="{Binding ShowLeaderboardCommand}"
                        Background="{StaticResource ButtonBlue2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Leaderboard"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        Margin="5"
                        BorderThickness="6, 6, 6, 6"
                        Command="{Binding ExitCommand}"
                        Background="{StaticResource ButtonOrange3Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Exit"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Border Grid.Row="5" Grid.Column="0" Background="#33000000" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="1" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="2" Background="#33000000" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="3" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="4" Background="#33000000" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="5" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="6" Background="#33000000" BorderBrush="Black" BorderThickness="0 0 0 6" />
                <Border Grid.Row="5" Grid.Column="7" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 6" />
            </Grid>
</UserControl>