<UserControl x:Class="BattleChess3.UI.MainWindow.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mainWindow="clr-namespace:BattleChess3.UI.MainWindow"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance mainWindow:NotificationService}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Canvas>
        <Button x:Name="NotificationButton"
                Canvas.Right="30" Canvas.Top="30"
                FontSize="35"
                IsEnabled="False"
                Visibility="Collapsed"
                BorderThickness="6, 6, 6, 6"
                Background="{StaticResource ButtonOrangeBackground}"
                Style="{StaticResource ScalingButtonStyle}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="NotificationTextBlock"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Width="200"
                           FontSize="15" Margin="20 10"/>
            </Border>
        </Button>
    </Canvas>
</UserControl>
