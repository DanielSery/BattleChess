<UserControl x:Class="BattleChess3.UI.Menu.MultiplayerLobbyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:menu="clr-namespace:BattleChess3.UI.Menu"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance menu:MultiplayerViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Command="{Binding EnterCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding RequestEndCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0"
                Content="Name"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonBlueBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <TextBox Grid.Row="0" Grid.Column="1"
                 BorderThickness="2 2 4 2"
                 FontSize="25"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.85" />

        <Button Grid.Row="1" Grid.Column="0"
                Content="Password"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonPurple2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <PasswordBox Grid.Row="1" Grid.Column="1"
                     BorderThickness="2 2 4 4"
                     FontSize="25"
                     Background="#40000000"
                     Padding="10"
                     Password=""
                     Opacity="0.85" 
                     PasswordChanged="PasswordBox_OnPasswordChanged"/>
        
        <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  x:Name="MyDataGrid"
                  Margin="-2"
                  ItemsSource="{Binding Lobbies}"
                  SelectionUnit="FullRow"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MouseDoubleClick="Control_OnMouseDoubleClick"
                  SnapsToDevicePixels="True"
                  AutoGenerateColumns="False"
                  FontSize="15"
                  IsReadOnly="True">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter"
                            Command="{Binding JoinLobbyCommand}" />
                <KeyBinding Key="Escape"
                            Command="{Binding RequestEndCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding LobbyName}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
                <DataGridTextColumn Header="Elo" Binding="{Binding Elo}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
                <DataGridTextColumn Header="Locked" Binding="{Binding Locked}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Create lobby"
                BorderThickness="2 4 2 2"
                FontSize="25"
                Command="{Binding CreateLobbyCommand}"
                Background="{StaticResource ButtonGreenBackground}"
                Padding="10" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Join lobby"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Command="{Binding JoinLobbyCommand}"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10" />
    </Grid>
</UserControl>
