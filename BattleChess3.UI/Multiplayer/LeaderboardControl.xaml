<UserControl x:Class="BattleChess3.UI.Multiplayer.LeaderboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:multiplayer="clr-namespace:BattleChess3.UI.Multiplayer"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance multiplayer:LeaderboardViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding RequestEndCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Leaderboard}"
                  Margin="-2"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  FontSize="15"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
                <DataGridTextColumn Header="Elo" Binding="{Binding Elo}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>     
        
        <Button Grid.Row="1"
                Content="Back"
                BorderThickness="2 4 2 4"
                FontSize="25"
                Command="{Binding RequestEndCommand}"
                Background="{StaticResource ButtonOrangeBackground}"
                Padding="10" />   
    </Grid>
</UserControl>
