<UserControl x:Class="BattleChess3.UI.Multiplayer.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:multiplayer="clr-namespace:BattleChess3.UI.Multiplayer"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance multiplayer:LoginViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Command="{Binding LoginCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding RequestEndCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0"
                Content="Name"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonBlueBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <TextBox Grid.Row="0" Grid.Column="1"
                 BorderThickness="2 2 4 2"
                 FontSize="25"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.85" />

        <Button Grid.Row="1" Grid.Column="0"
                Content="Password"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonPurple2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <PasswordBox Grid.Row="1" Grid.Column="1"
                 BorderThickness="2 2 4 4"
                 FontSize="25"
                 Background="#40000000"
                 Padding="10"
                 Password=""
                 Opacity="0.85" 
                 PasswordChanged="PasswordBox_OnPasswordChanged"/>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Login"
                BorderThickness="2 4 2 2"
                FontSize="25"
                Command="{Binding LoginCommand}"
                Background="{StaticResource ButtonGreen3Background}"
                Padding="10" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Back"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Command="{Binding RequestEndCommand}"
                Background="{StaticResource ButtonOrangeBackground}"
                Padding="10" />
    </Grid>
</UserControl>