<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BitmapImage x:Key="Preview"
                 UriSource="pack://application:,,,/BattleChess3;component/Resources/Images/Preview.png" />
    <ImageBrush x:Key="ApplicationBackground"
                Stretch="UniformToFill"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ApplicationBackground.jpg" />

    <SolidColorBrush x:Key="DefaultObjectForeground" Color="Black" />
    <SolidColorBrush x:Key="DefaultObjectMouseOnForeground" Color="#292944" />
    <SolidColorBrush x:Key="DefaultObjectSelectedForeground" Color="#1C5945" />
    <SolidColorBrush x:Key="DefaultObjectDisabledForeground" Color="#6D3651" />

    <ImageBrush x:Key="DefaultButtonBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/DefaultButton.png" />
    <ImageBrush x:Key="DefaultButtonMouseOnBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/DefaultButtonMouseOn.png" />

    <ImageBrush x:Key="ChessTileOutsideBoardBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileOutsideBoard.png" />
    <ImageBrush x:Key="ChessTileMouseOnBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileMouseOn.png" />
    <ImageBrush x:Key="ChessTileSelectedBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileSelected.png" />
    <ImageBrush x:Key="ChessTileSpecialBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileSpecial.png" />
    <ImageBrush x:Key="ChessTileCanGoBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileCanGo.png" />
    <ImageBrush x:Key="ChessTileDangeredBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileDangered.png" />

    <ImageBrush x:Key="ChessTileKingBaseBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileKingBase.png" />
    <ImageBrush x:Key="ChessTileKingMouseOnBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileKingMouseOn.png" />
    <ImageBrush x:Key="ChessTileKingSelectedBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileKingSelected.png" />
    <ImageBrush x:Key="ChessTileKingSpecialBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileKingSpecial.png" />
    <ImageBrush x:Key="ChessTileKingDangeredBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ChessTileKingDangered.png" />
    
    <ImageBrush x:Key="ButtonYellowBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonYellowBackground.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonBlueBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonBlueBackground.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonBlue2Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonBlue2Background.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonGreenBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonGreenBackground.jpg"
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonGreen2Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonGreen2Background.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonGreen3Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonGreen3Background.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonRedBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonRedBackground.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonRed2Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonRed2Background.png" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonOrangeBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonOrangeBackground.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonOrange2Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonOrange2Background.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonOrange3Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonOrange3Background.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonPurpleBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonPurpleBackground.jpg" 
                Stretch="UniformToFill"/>
    <ImageBrush x:Key="ButtonPurple2Background"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonPurple2Background.jpg" 
                Stretch="UniformToFill"/>
    
    <ImageBrush x:Key="ButtonWhiteBackground"
                ImageSource="pack://application:,,,/BattleChess3;component/Resources/Images/ButtonWhiteBackground.jpg" 
                Stretch="UniformToFill"/>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="BorderThickness" Value="0 0 0 0" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Header}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource TabItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="100" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Header}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
                <Setter Property="Background" Value="{StaticResource TabItemBackground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="Background" Value="{StaticResource TabItemMouseOnBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="Background" Value="{StaticResource TabItemMouseOnBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectDisabledForeground}" />
                <Setter Property="Background" Value="{StaticResource TabItemDisabledBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <ControlTemplate x:Key="ScrollViewerControlTemplate" TargetType="{x:Type ScrollViewer}">
        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle x:Name="Corner" Grid.Column="1" Fill="{StaticResource {x:Static SystemColors.ControlBrushKey}}" Grid.Row="1"/>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.RowSpan="2" Margin="{TemplateBinding Padding}" Grid.ColumnSpan="2"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Width="8"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Orientation="Horizontal" Grid.Row="1" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}" Height="8"/>
        </Grid>
    </ControlTemplate>
    
    <Style x:Key="VerticalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle Fill="Black" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="HorizontalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle Fill="Black" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible"
                                      Margin="0 0 0 0"
                                      Padding="1 1 7 1"
                                      Template="{StaticResource ScrollViewerControlTemplate}">
                            <StackPanel IsItemsHost="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
        <Setter Property="Foreground" Value="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="MaxWidth" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="#30000000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.00001*"/>
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VerticalThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="MinHeight" Value="4"/>
                <Setter Property="MaxHeight" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="#30000000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.00001*"/>
                                </Grid.ColumnDefinitions>
                                <Track x:Name="PART_Track" Grid.Column="1" IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource HorizontalThumb}" Height="8"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScalingButtonStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}"/>
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Viewbox>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="5" />
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectMouseOnForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}"/>
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="10" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectMouseOnForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}"/>
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Background -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" >
                        </Border>
                
                        <!-- Password Content -->
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectMouseOnForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectForeground}"/>
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <!-- Background -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" >
                        </Border>
                
                        <!-- Password Content -->
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DefaultObjectMouseOnForeground}" />
                <Setter Property="BorderBrush" Value="{StaticResource DefaultObjectMouseOnForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MainWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ApplicationBackground}" />
    </Style>

    <Style x:Key="TextBlockStyle" TargetType="TextBlock">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DefaultObjectForeground}" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    
    <Style x:Key="EditorChessButtonStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ChessTileOutsideBoardBackground}" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Canvas Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileMouseOnBackground}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileSelectedBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChessButtonStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Canvas Background="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Canvas Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBlack}" Value="True">
                <Setter Property="Background" Value="#40000000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPossibleMove}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileCanGoBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPossibleSpecial}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileSpecialBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPossibleAttack}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileDangeredBackground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileMouseOnBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileSelectedBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style TargetType="ResizeGrip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGrip">
                    <Canvas Width="16" Height="16">
                        <Polygon Points="0,16 16,16 16,0" Fill="Black"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Margin="5 0 5 0 ">
                            <!-- Black Track Line -->
                            <Rectangle Height="3" Fill="Black" VerticalAlignment="Center"/>
                            
                            <!-- Track with only Thumb -->
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}">
                                <Track.Thumb>
                                    <Thumb Width="6" Height="15">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="Black"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Rectangle Fill="{TemplateBinding Background}"
                                                                       Opacity="{TemplateBinding Opacity}"
                                                                       Width="{TemplateBinding Width}"
                                                                       Height="{TemplateBinding Height}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="20"/>
        </Style>
    
    <!-- DataGrid Style -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#20000000"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/> <!-- Hides the row header column -->
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
    </Style>

    <!-- DataGridRow Style -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="25"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#30000000"/> <!-- New selected row color -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGridCell Style -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    
    <Style x:Key="CellTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- DataGridColumnHeader Style -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#40000000"/> <!-- New header color -->
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Padding" Value="10 4"/>
        <Setter Property="BorderThickness" Value="2 2 2 4"/>
        <Setter Property="Margin" Value="0 -1 -1 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChessButtonKingStyle" TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ChessTileKingBaseBackground}" />
        <Setter Property="FontWeight" Value="Heavy" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Canvas Background="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Canvas Background="{TemplateBinding BorderBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBlack}" Value="True">
                <Setter Property="Background" Value="#40000000"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPossibleSpecial}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileKingSpecialBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPossibleAttack}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileKingDangeredBackground}" />
            </DataTrigger>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileKingMouseOnBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ChessTileKingSelectedBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="MyDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>