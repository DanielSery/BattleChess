<UserControl x:Class="BattleChess3.UI.Views.EditorUnitsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="clr-namespace:Nicenis.Windows;assembly=Nicenis"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModel:EditorUnitsViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
   <Border BorderBrush="Black" BorderThickness="0 0 0 6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Visible"
                              Margin="0 0 0 0"
                              Template="{StaticResource ScrollViewerControlTemplate}"
                              Drop="Figures_Drop"
                              AllowDrop="True">
                    <ItemsControl HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Figures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource EditorChessButtonStyle}"
                                    GotFocus="FigureButton_GotFocus"
                                    LostFocus="FigureButton_LostFocus"
                                    MouseEnter="FigureButton_MouseEnter"
                                    MouseLeave="FigureButton_MouseLeave"
                                    n:DragSource.AllowDrag="True"
                                    n:DragSource.AllowedEffects="Copy"
                                    n:DragSource.Dragging="ChessImage_DragEnter"
                                    MaxWidth="100">
                                    <Image Source="{Binding ImageUri}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
</UserControl>
