<UserControl x:Class="BattleChess3.UI.Views.GameBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModel:BoardViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border BorderBrush="Black" BorderThickness="0 0 6 0"
            SnapsToDevicePixels="True"
            x:Name="ThisGameBoardControl"
            Width="{Binding ActualHeight, ElementName=ThisGameBoardControl}">
        <ItemsControl HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding BoardWidth}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.PlayTileCommand, ElementName=ThisGameBoardControl}"
                            CommandParameter="{Binding}"
                            Style="{Binding .Figure.IsKing, Converter={converters:BooleanMultiValueConverter TrueValue={StaticResource ChessButtonKingStyle}, FalseValue={StaticResource ChessButtonStyle}}}"
                            d:DataContext="{d:DesignInstance viewModel:TileViewModel}"
                            MouseEnter="Button_MouseEnter"
                            MouseLeave="Button_MouseLeave">
                        <Image Source="{Binding Figure.ImageUri}" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>