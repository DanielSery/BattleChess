<UserControl x:Class="BattleChess3.UI.Views.LeaderboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModel:LeaderboardViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <DataGrid ItemsSource="{Binding Leaderboard}"
              Margin="-2"
              SelectionUnit="FullRow"
              SnapsToDevicePixels="True"
              AutoGenerateColumns="False"
              FontSize="15"
              IsReadOnly="True">

        <DataGrid.Columns>
            <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
            <DataGridTextColumn Header="Elo" Binding="{Binding Elo}" Width="Auto" ElementStyle="{StaticResource CellTextStyle}"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
