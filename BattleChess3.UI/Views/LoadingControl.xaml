<UserControl x:Class="BattleChess3.UI.Views.LoadingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:BattleChess3.UI.Services"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance services:LoadingService}"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <QuadraticEase x:Key="Ease" EasingMode="EaseInOut"/>
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">

            <!-- Spinner rotates -->
            <DoubleAnimation
                Storyboard.TargetName="SpinnerRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:1.5"
                RepeatBehavior="Forever"
                EasingFunction="{StaticResource Ease}" />

            <!-- Ellipse pulses (scales) -->
            <DoubleAnimation
                Storyboard.TargetName="EllipsePulse"
                Storyboard.TargetProperty="ScaleX"
                From="1" To="1.15"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="EllipsePulse"
                Storyboard.TargetProperty="ScaleY"
                From="1" To="1.15"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid x:Name="LoadingOverlay"
          Background="#A0000000"
          Visibility="Collapsed"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Panel.ZIndex="999">
    
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Orientation="Vertical">

            <!-- Spinner -->
            <Canvas Width="60" Height="60">
                <Canvas.RenderTransform>
                    <ScaleTransform CenterX="30" CenterY="30" ScaleX="1.3" ScaleY="1.3"/>
                </Canvas.RenderTransform>
                    
                <Ellipse x:Name="InnerEllipse"
                    Width="55" Height="55" Fill="#00000000" StrokeThickness="0"
                    MouseEnter="Spinner_MouseEnter"
                    MouseLeave="Spinner_MouseLeave"
                    MouseUp="Spinner_MouseUp"/>
                    
                <!-- Pulsing Ellipse -->
                <Ellipse x:Name="OuterEllipse"
                    Width="60" Height="60" Stroke="#80C1B6A4" StrokeThickness="8">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="EllipsePulse" CenterX="30" CenterY="30"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Rotating Path -->
                <Path x:Name="SpinnerPath"
                      Stroke="#C0C1B6A4" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M30,5 A25,25 0 1 1 29.9,5.0"
                      MouseEnter="Spinner_MouseEnter"
                      MouseLeave="Spinner_MouseLeave"
                      MouseUp="Spinner_MouseUp">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="30" CenterY="30"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
                
            <!-- Loading Text -->
            <TextBlock x:Name="ThisTextBlock"
                        Text="Loading..." Foreground="#C1B6A4" FontWeight="SemiBold"
                       Margin="25"
                       FontSize="25" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
