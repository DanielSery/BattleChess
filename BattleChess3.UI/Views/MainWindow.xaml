<Window x:Class="BattleChess3.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BattleChess3.UI.Views"
        xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
        xmlns:localization="clr-namespace:BattleChess3.UI.Localization"
        xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
        mc:Ignorable="d"
        Title="{localization:Loc MainWindow_Title}" Height="800" Width="1035" MinHeight="600" MinWidth="1035"
        d:DataContext="{d:DesignInstance viewModel:MainWindowViewModel}"
        DataContext="{Binding Source={x:Static viewModel:ViewModelLocator.MainWindowViewModel}}"
        Style="{StaticResource MainWindowStyle}">
    <!-- WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" -->
    <Grid>
        <Border Visibility="{Binding MenuTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
            <views:MenuControl DataContext="{Binding MenuViewModel}"/>
        </Border>
        
        <DockPanel LastChildFill="True"
                   Visibility="{Binding GameTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
            <Border DockPanel.Dock="Left">
                <views:GameBoardControl DataContext="{Binding BoardViewModel}" />
            </Border>
            <Border BorderBrush="Black" BorderThickness="3,0,0,0">
                <views:UnitInfoControl DataContext="{Binding BoardViewModel.TileInfo.Figure}" />
            </Border>
        </DockPanel>
        
        <Border Visibility="{Binding EditorTabSelected, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
            <views:EditorControl DataContext="{Binding EditorViewModel}"/>
        </Border>
    </Grid>
</Window>