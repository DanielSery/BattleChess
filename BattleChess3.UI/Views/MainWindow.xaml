<Window x:Class="BattleChess3.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:BattleChess3.UI.Views"
        xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
        xmlns:localization="clr-namespace:BattleChess3.UI.Localization"
        mc:Ignorable="d"
        Title="{localization:Loc MainWindow_Title}" Height="800" Width="1035" MinHeight="600" MinWidth="1035"
        DataContext="{Binding Source={x:Static viewModel:ViewModelLocator.MainWindowViewModel}}"
        Style="{StaticResource MainWindowStyle}">
    <!-- WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" -->
    <TabControl>
        <TabItem IsSelected="{Binding MenuTabSelected}">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
                    <DockPanel>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding NewGameCommand}"
                                Content="{localization:Loc MainWindow_NewGame}" 
                                BorderThickness="10 10 10 5"
                                Background="{StaticResource ButtonBlueBackground}"/>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding JoinGameCommand}"
                                Content="{localization:Loc MainWindow_JoinGame}" 
                                BorderThickness="10 5 10 5"
                                Background="{StaticResource ButtonPurpleBackground}"/>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding SaveGameCommand}"
                                Content="{localization:Loc MainWindow_SaveGame}" 
                                BorderThickness="10 5 10 5"
                                Background="{StaticResource ButtonRedBackground}"/>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding DeleteGameCommand}"
                                Content="{localization:Loc MainWindow_DeleteGame}" 
                                BorderThickness="10 5 10 5"
                                Background="{StaticResource ButtonOrangeBackground}"/>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding EditorCommand}"
                                Content="Editor" 
                                BorderThickness="10 5 10 5"
                                Background="{StaticResource ButtonGreen2Background}"/>
                        <Button Height="125" Width="300"
                                DockPanel.Dock="Top"
                                Command="{Binding CloseApplicationCommand}"
                                Content="{localization:Loc MainWindow_Quit}" 
                                BorderThickness="10 5 10 10"
                                Background="{StaticResource ButtonOrange2Background}"/>
                    </DockPanel>
                </Viewbox>
                <views:MapsControl MinWidth="500"
                                   DataContext="{Binding MapsViewModel}" />
            </DockPanel>
        </TabItem>
        <TabItem IsSelected="{Binding GameTabSelected}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left">
                    <views:GameBoardControl
                        x:Name="GameBoard"
                        DataContext="{Binding BoardViewModel}" />
                </Border>
                <Border DockPanel.Dock="Top"
                        BorderBrush="Black" BorderThickness="10,0,0,5">
                    <views:MultiplayerControl DataContext="{Binding MultiplayerViewModel}" />
                </Border>
                <Border BorderBrush="Black" BorderThickness="10,0,0,0">
                    <views:UnitInfoControl DataContext="{Binding BoardViewModel.TileInfo.Figure}" />
                </Border>
            </DockPanel>
        </TabItem>
        <TabItem IsSelected="{Binding EditorTabSelected}">
            <views:EditorControl DataContext="{Binding EditorViewModel}"/>
        </TabItem>
    </TabControl>
</Window>