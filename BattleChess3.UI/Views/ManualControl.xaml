<UserControl x:Class="BattleChess3.UI.Views.ManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
             DataContext="{Binding Source={x:Static viewModel:ViewModelLocator.FiguresViewModel}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ItemsControl Grid.Column="0"
                      ItemsSource="{Binding FigureGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding DisplayName}"
                            Command="{Binding DataContext.SelectFigureGroupCommand, 
                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource ManualButtonStyle}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Column="1"
                      Foreground="Black" Background="{DynamicResource TextBoxBrush}"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl DataContext="{Binding SelectedFigureGroup}"
                          ItemsSource="{Binding FigureTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel FlowDirection="LeftToRight"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10"
                                BorderBrush="Black" BorderThickness="10">
                            <DockPanel>
                                <ItemsControl DockPanel.Dock="Right"
                                              ItemsSource="{Binding ImageUris}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Width="200" Source="{Binding Value}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding Path=BaseDescription}"
                                           Style="{DynamicResource TextBlockStyle}" 
                                           Visibility="{Binding BaseDescription, Converter={converters:IsStringEmptyMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"/>

                                <WrapPanel>
                                    <TextBlock Text="{Binding Path=MovementDescription}"
                                               Visibility="{Binding MovementDescription, Converter={converters:IsStringEmptyMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                                               Style="{DynamicResource TextBlockStyle}" 
                                               Margin="20"/>
                                    
                                    <TextBlock Text="{Binding Path=AttackDescription}"
                                               Visibility="{Binding AttackDescription, Converter={converters:IsStringEmptyMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                                               Style="{DynamicResource TextBlockStyle}" 
                                               Margin="20"/>
                                    
                                    <TextBlock Text="{Binding Path=SpecialDescription}"
                                               Visibility="{Binding SpecialDescription, Converter={converters:IsStringEmptyMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                                               Style="{DynamicResource TextBlockStyle}" 
                                               Margin="20"/>
                                </WrapPanel>

                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>