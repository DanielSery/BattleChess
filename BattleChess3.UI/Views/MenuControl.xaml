<UserControl x:Class="BattleChess3.UI.Views.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             xmlns:views="clr-namespace:BattleChess3.UI.Views"
             xmlns:localization="clr-namespace:BattleChess3.UI.Localization"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             d:DataContext="{d:DesignInstance viewModel:MenuViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="350">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left"
                BorderBrush="Black" BorderThickness="0 0 6 0"
                SnapsToDevicePixels="True"
                x:Name="ThisBorderControl"
                Width="{Binding ActualHeight, ElementName=ThisBorderControl}">
            <Grid DockPanel.Dock="Left" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="1" Background="#40000000" />
                <Border Grid.Row="0" Grid.Column="3" Background="#40000000" />
                <Border Grid.Row="0" Grid.Column="5" Background="#40000000" />
                <Border Grid.Row="0" Grid.Column="7" Background="#40000000" />

                <Border Grid.Row="1" Grid.Column="0" Background="#40000000" />
                <Border Grid.Row="1" Grid.Column="2" Background="#40000000" />
                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        Command="{Binding LocalGameCommand}"
                        BorderThickness="6, 6, 6, 6"
                        Background="{StaticResource ButtonBlueBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="{localization:Loc MainWindow_NewGame}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="1" Grid.Column="6" Background="#40000000" />

                <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                        Command="{Binding RankedGameCommand}"
                        Background="{StaticResource ButtonOrangeBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Ranked game"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Button Grid.Row="2" Grid.Column="1"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 3, 6"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                        Command="{Binding ShowLoginCommand}"
                        Background="{StaticResource ButtonOrangeBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="112" MinHeight="40">
                        <TextBlock Text="Log in"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>

                <Button Grid.Row="2" Grid.Column="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="3, 6, 6, 6"
                        Visibility="{Binding LoginViewModel.IsLoggedIn, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                        Command="{Binding ShowSignUpCommand}"
                        Background="{StaticResource ButtonOrange2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="112" MinHeight="40">
                        <TextBlock Text="Sign up"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="2" Grid.Column="3" Background="#40000000" />
                <Button Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 6, 6"
                        Command="{Binding HostGameCommand}"
                        Background="{StaticResource ButtonGreenBackground}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Host and copy"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="2" Grid.Column="7" Background="#40000000" />

                <Border Grid.Row="3" Grid.Column="0" Background="#40000000" />
                <Border Grid.Row="3" Grid.Column="2" Background="#40000000" />
                <Button Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        Command="{Binding SelectEditorCommand}"
                        BorderThickness="6, 6, 6, 6"
                        Background="{StaticResource ButtonPurple2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Edit setup"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="3" Grid.Column="6" Background="#40000000" />

                <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 6, 6"
                        Background="{StaticResource ButtonOrange3Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Leaderboard"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="4" Grid.Column="3" Background="#40000000" />
                <Button Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2"
                        DockPanel.Dock="Top"
                        FontSize="35"
                        BorderThickness="6, 6, 6, 6"
                        Command="{Binding JoinGameCommand}"
                        Background="{StaticResource ButtonGreen2Background}"
                        Style="{StaticResource ScalingButtonStyle}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="225" MinHeight="40">
                        <TextBlock Text="Paste and join"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="35"/>
                    </Border>
                </Button>
                <Border Grid.Row="4" Grid.Column="7" Background="#40000000" />

                <Border Grid.Row="5" Grid.Column="0" Background="#40000000" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="1" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="2" Background="#40000000" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="3" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="4" Background="#40000000" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="5" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="6" Background="#40000000" BorderBrush="Black" BorderThickness="0 0 0 9" />
                <Border Grid.Row="5" Grid.Column="7" Background="Transparent" BorderBrush="Black" BorderThickness="0 0 0 9" />

                <Border Grid.Column="0" Grid.ColumnSpan="8" Grid.Row="6" Grid.RowSpan="2" SnapsToDevicePixels="True">
                    <views:TeamBoardControl DataContext="{Binding TeamBoardViewModel}" 
                                            Opacity="0.85"/>
                </Border>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="3 0 6 0"
                SnapsToDevicePixels="True">
            <Grid>
                <Border Visibility="{Binding LoginShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                    <views:LoginControl DataContext="{Binding LoginViewModel}"/>
                </Border>
                <Border Visibility="{Binding SignUpShown, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}">
                    <views:SignUpControl DataContext="{Binding SignUpViewModel}"/>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>