<UserControl x:Class="BattleChess3.UI.Views.MultiplayerLobbyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModel:MultiplayerViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0"
                Content="Name"
                BorderThickness="3 6 3 3"
                FontSize="25"
                Background="{StaticResource ButtonBlueBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <TextBox Grid.Row="0" Grid.Column="1"
                 BorderThickness="3 6 6 3"
                 FontSize="25"
                 Text="{Binding Name}"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.85" />

        <Button Grid.Row="1" Grid.Column="0"
                Content="Password"
                BorderThickness="3 3 3 6"
                FontSize="25"
                Background="{StaticResource ButtonPurple2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.85" />

        <PasswordBox Grid.Row="1" Grid.Column="1"
                     BorderThickness="3 3 6 6"
                     FontSize="25"
                     Background="#40000000"
                     Padding="10"
                     Password=""
                     Opacity="0.85" 
                     PasswordChanged="PasswordBox_OnPasswordChanged"/>
        
        <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  ItemsSource="{Binding Lobbies}"
                  SelectionUnit="FullRow"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
        </DataGrid>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Create lobby"
                BorderThickness="3 6 3 3"
                FontSize="25"
                Command="{Binding CreateLobbyCommand}"
                Background="{StaticResource ButtonGreenBackground}"
                Padding="10" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Join lobby"
                BorderThickness="3 3 3 6"
                FontSize="25"
                Command="{Binding JoinLobbyCommand}"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10" />
    </Grid>
</UserControl>
