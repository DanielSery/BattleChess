<UserControl x:Class="BattleChess3.UI.Views.TeamBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="clr-namespace:Nicenis.Windows;assembly=Nicenis"
             xmlns:viewModel="clr-namespace:BattleChess3.UI.ViewModel"
             xmlns:converters="clr-namespace:BattleChess3.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModel:TeamBoardViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="ThisTeamBoardControl">
    <ItemsControl HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Tiles}"
                  x:Name="ThisBoard">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding BoardWidth}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button
                    Command="{Binding DataContext.MakeUnitKingCommand, ElementName=ThisTeamBoardControl}"
                    CommandParameter="{Binding}"
                    Style="{Binding .Figure.IsKing, Converter={converters:BooleanMultiValueConverter TrueValue={StaticResource ChessButtonKingStyle}, FalseValue={StaticResource ChessButtonStyle}}}"
                    d:DataContext="{d:DesignInstance viewModel:TileViewModel}"
                    n:DragSource.AllowDrag="True"
                    n:DragSource.AllowedEffects="Move"
                    n:DragSource.Dragging="ChessButton_DragEnter"
                    Drop="ChessImage_Drop"
                    AllowDrop="True">
                    <Image Source="{Binding Figure.ImageUri}" />
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
