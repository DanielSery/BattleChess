<UserControl x:Class="CrownsGuard.UI.Editor.EditorSideControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:CrownsGuard.UI.Converters"
             xmlns:localization="clr-namespace:CrownsGuard.UI.Localization"
             xmlns:editor="clr-namespace:CrownsGuard.UI.Editor"
             xmlns:game="clr-namespace:CrownsGuard.UI.Game"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance editor:EditorViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Command="{Binding SaveGameCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <Grid DockPanel.Dock="Right">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="{Binding  TeamBoard.PointsLeft}"
                ContentStringFormat="{localization:Loc Editor_AvailablePointsFormat}"
                Visibility="{Binding TeamBoard.PositivePoints, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonGreenBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <Button Grid.Row="0"
                Content="{Binding TeamBoard.PointsLeft}"
                ContentStringFormat="{localization:Loc Editor_AvailablePointsFormat}"
                Visibility="{Binding TeamBoard.PositivePoints, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonRedBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <Button Grid.Row="1"
                Visibility="{Binding TeamBoard.HasKing, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                Content="{localization:Loc Editor_KingNotSelected}"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonRed2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <Button Grid.Row="1"
                Visibility="{Binding TeamBoard.HasKing, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                Content="{localization:Loc Editor_KingSelected}"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <Border Grid.Row="2"
                BorderBrush="Black" BorderThickness="2 0 0 0"
                SnapsToDevicePixels="True">
            <game:UnitInfoControl DataContext="{Binding EditorUnits.TileInfo}" />
        </Border>

        <Button Grid.Row="3"
                Command="{Binding SaveGameCommand}"
                Content="{localization:Loc Editor_Save}"
                BorderThickness="2 4 2 2"
                Opacity="{Binding TeamBoard.CanSave, Converter={converters:BooleanMultiValueConverter TrueValue=1.0, FalseValue=0.5}}"
                IsEnabled="{Binding TeamBoard.CanSave}"
                FontSize="25"
                Background="{StaticResource ButtonGreen3Background}"
                Padding="10" />

        <Button Grid.Row="4"
                Command="{Binding CancelCommand}"
                Content="{localization:Loc Editor_Cancel}"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonOrangeBackground}"
                Padding="10" />
    </Grid>
</UserControl>