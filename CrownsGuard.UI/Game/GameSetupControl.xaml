<UserControl x:Class="CrownsGuard.UI.Game.GameSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:game="clr-namespace:CrownsGuard.UI.Game"
             xmlns:converters="clr-namespace:CrownsGuard.UI.Converters"
             d:DataContext="{d:DesignInstance game:GameSetupViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding RequestEndCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Command="{Binding ChangeSetupOptionCommand}"
                Content="{Binding RandomSetup, Converter={converters:BooleanMultiValueConverter TrueValue=Random setup, FalseValue=Selected setup}}"
                BorderThickness="2 2 2 2"
                Background="{StaticResource ButtonGreen2Background}"
                FontSize="25"
                Padding="10" />

        <Button Grid.Row="1" Grid.Column="0"
                Content="AI Difficulty"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonGreenBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <Slider Grid.Row="1" Grid.Column="1"
                Minimum="1" Value="{Binding Difficulty, UpdateSourceTrigger=PropertyChanged}" Maximum="4"></Slider>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Hot seat game"
                BorderThickness="2 4 2 2"
                FontSize="25"
                Command="{Binding StartHotSeatCommand}"
                Background="{StaticResource ButtonGreenBackground}"
                Padding="10" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Content="AI game"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Command="{Binding StartAiGameCommand}"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10" />

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Back"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Command="{Binding RequestEndCommand}"
                Background="{StaticResource ButtonOrangeBackground}"
                Padding="10" />
    </Grid>
</UserControl>
