<UserControl x:Class="CrownsGuard.UI.Multiplayer.SignUpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:CrownsGuard.UI.Converters"
             xmlns:multiplayer="clr-namespace:CrownsGuard.UI.Multiplayer"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance multiplayer:SignUpViewModel}"
             d:DesignHeight="300" d:DesignWidth="300"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Command="{Binding SignUpCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding RequestEndCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0"
                Content="Name"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonBlueBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="2 2 4 2"
                 FontSize="25"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.8" />

        <Button Grid.Row="1" Grid.Column="0"
                Content="Password"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonPurple2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <PasswordBox Grid.Row="1" Grid.Column="1"
                     BorderThickness="2 2 4 2"
                     FontSize="25"
                     Background="#40000000"
                     Padding="10"
                     Opacity="0.8" 
                     PasswordChanged="PasswordBox1_OnPasswordChanged"/>

        <Button Grid.Row="2" Grid.Column="0"
                Content="Password"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonPurpleBackground}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <PasswordBox Grid.Row="2" Grid.Column="1"
                     BorderThickness="2 2 4 2"
                     FontSize="25"
                     Background="#40000000"
                     Padding="10"
                     Opacity="0.8" 
                     PasswordChanged="PasswordBox2_OnPasswordChanged"/>
        
        <Button Grid.Row="3" Grid.Column="0"
                Content="E-Mail"
                BorderThickness="2 2 2 2"
                FontSize="25"
                Background="{StaticResource ButtonOrange2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="2 2 4 2"
                 FontSize="25"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.8" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Verify e-mail"
                Visibility="{Binding VerificationInProgress, Converter={converters:BooleanMultiValueConverter TrueValue=Collapsed, FalseValue=Visible}}"
                BorderThickness="2 2 4 4"
                FontSize="25"
                Command="{Binding VerifyEmailCommand}"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10" />

        <Button Grid.Row="4" Grid.Column="0"
                Content="Verification"
                Visibility="{Binding VerificationInProgress, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Background="{StaticResource ButtonGreen2Background}"
                Padding="10"
                IsEnabled="False" Opacity="0.8" />

        <TextBox Grid.Row="4" Grid.Column="1"
                 Text="{Binding EmailVerificationCode, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding VerificationInProgress, Converter={converters:BooleanMultiValueConverter TrueValue=Visible, FalseValue=Collapsed}}"
                 BorderThickness="2 2 4 4"
                 FontSize="25"
                 Background="#40000000"
                 Padding="10"
                 Opacity="0.8" />

        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Sign up"
                BorderThickness="2 4 2 2"
                FontSize="25"
                Command="{Binding SignUpCommand}"
                Background="{StaticResource ButtonGreen3Background}"
                Padding="10" />

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Back"
                BorderThickness="2 2 2 4"
                FontSize="25"
                Command="{Binding RequestEndCommand}"
                Background="{StaticResource ButtonOrangeBackground}"
                Padding="10" />
    </Grid>
</UserControl>
